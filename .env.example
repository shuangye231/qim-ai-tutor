# 复制为 .env 后填写。不要提交真实密钥。
# 安装脚本会提示你设置管理员密钥，也可以手动填写一个至少 32 位的随机字符串。
ADMIN_API_KEY=replace-with-a-long-random-secret
PRO_API_KEY=
# 可选：如果 PRO_API_KEY 已填写，通常不需要重复填写。
CCODE_API_KEY=
CLOUD_BASE_URL=https://api.ccode.vip/v1

# MVP 商业规则：Flash 和 Pro 合计每天免费 5 次；当前仅模拟支付。
FREE_DAILY_QUESTIONS=5
PAYMENT_PROVIDER=mock

HF_ENDPOINT=https://huggingface.co
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# 首次启动下载 Embedding 模型；下载完成后可改为 1 离线运行。
HF_OFFLINE=0
